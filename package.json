{
  "name": "subbase",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "tokens": "node design-system/scripts/build-tokens.mjs",
    "contrast": "node design-system/scripts/check-contrast.mjs",
    "dev": "npm run tokens && vite",
    "typecheck": "tsc -p . --noEmit",
    "build": "npm run tokens && tsc -p . --noEmit && vite build",
    "preview": "vite preview",
    "i18n:check": "node --experimental-strip-types src/i18n/check-parity.ts",
    "sync": "node scripts/sync-from-template.mjs",
    "bump": "node scripts/bump-version.mjs",
    "preset": "node design-system/scripts/create-preset.mjs"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "ldrs": "^1.1.9",
    "motion": "^13.0.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-ellipsis-component": "^1.1.11",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "react-tooltip": "^5.30.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "yaml": "^2.6.0"
  }
